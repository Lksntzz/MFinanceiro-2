{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "m-financeiro-2.vercel.app"
        }
      ],
      "destination": "https://mfinanceiro.com.br/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin-login",
      "destination": "/"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    }
  ]
}

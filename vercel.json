{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "m-financeiro-2.vercel.app"
        }
      ],
      "destination": "https://mfinanceiro.com.br/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin-login",
      "destination": "/"
    },
    {
      "source": "/quick",
      "destination": "/index.html"
    },
    {
      "source": "/scan",
      "destination": "/index.html"
    },
    {
      "source": "/share",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    }
  ]
}

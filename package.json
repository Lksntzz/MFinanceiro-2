{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:modules && npm run test:unit",
    "test:modules": "node --import tsx scripts/module-boundaries-check.ts",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "security:check": "node --import tsx scripts/security-policy-check.ts && node --import tsx scripts/maintenance-rpc-contract-check.ts && node --import tsx scripts/access-approval-contract-check.ts",
    "product:check": "node --import tsx scripts/product-maturity-check.ts",
    "mobile:check": "node --import tsx scripts/mobile-logic-check.ts && node --import tsx scripts/native-shell-check.ts && node --import tsx scripts/mobile-layout-contract-check.ts",
    "check": "npm run lint && npm test && npm run security:check && npm run product:check && npm run mobile:check && npm run build",
    "native:sync": "npm run build && cap sync",
    "native:open:ios": "cap open ios",
    "native:open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.4.2",
    "@supabase/supabase-js": "^2.112.2",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "6.2.108",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.8.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/cli": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}

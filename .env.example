# Supabase (obrigatórias no Vite/Vercel)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-publicavel-ou-anon"

# URL pública da aplicação (opcional)
VITE_APP_URL="http://localhost:3000"

# MF Administração / observabilidade.
# São configurações públicas do cliente, nunca segredos.
# Deixe a URL vazia para desligar completamente o envio de telemetria.
# No Vercel Preview, alterações nestas variáveis exigem um novo deployment para entrarem no bundle.
VITE_MF_ADMIN_INGEST_URL=""
VITE_MF_DIAG_ENVIRONMENT="development"

# OCR visual de contas/recibos no MF Scan.
# A Edge Function document-ocr está publicada. Use false somente para desligar o recurso em um ambiente específico.
VITE_DOCUMENT_OCR_ENABLED="true"

# Nunca coloque chaves service_role, senhas do banco ou outros segredos administrativos
# em variáveis VITE_*: elas são incorporadas ao bundle do navegador.
# GEMINI_API_KEY, GEMINI_OCR_MODEL, GEMINI_DOCUMENT_OCR_MODEL,
# MF_FINANCEIRO_SERVICE_INGEST_SECRET e outros segredos do provedor/Open Finance
# devem ser configurados somente como secrets das Supabase Edge Functions.

# Supabase (obrigatórias no Vite/Vercel)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-publicavel-ou-anon"

# URL pública da aplicação (opcional)
VITE_APP_URL="http://localhost:3000"

# Nunca coloque chaves service_role, senhas do banco ou outros segredos administrativos
# em variáveis VITE_*: elas são incorporadas ao bundle do navegador.
# GEMINI_API_KEY e GEMINI_OCR_MODEL devem ser configuradas somente como secrets
# das Supabase Edge Functions.
#
# Open Finance real (Pluggy) — configurar somente como Supabase Edge Function secrets:
# PLUGGY_CLIENT_ID="..."
# PLUGGY_CLIENT_SECRET="..."
# OPEN_FINANCE_REDIRECT_URI="https://mfinanceiro.com.br/app/planejamento/automacoes"
#
# Nunca exponha PLUGGY_CLIENT_ID/PLUGGY_CLIENT_SECRET como VITE_*.

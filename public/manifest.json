{
  "name": "MF Financeiro - Controle Financeiro Inteligente",
  "short_name": "MF Financeiro",
  "description": "Seu controle financeiro inteligente de ponta a ponta.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#050505",
  "theme_color": "#071221",
  "icons": [
    {
      "src": "/mf-app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/mf-app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Novo lançamento",
      "short_name": "Lançar",
      "description": "Abrir o MF Quick para registrar uma despesa ou receita.",
      "url": "/quick"
    },
    {
      "name": "Escanear conta",
      "short_name": "MF Scan",
      "description": "Abrir a captura de boletos, Pix e documentos financeiros.",
      "url": "/scan"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            "image/jpeg",
            "image/png",
            "image/webp",
            ".pdf",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp"
          ]
        }
      ]
    }
  }
}
